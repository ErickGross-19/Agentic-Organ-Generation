{
  "schema": {
    "name": "aog_designspec",
    "version": "1.0.0",
    "compatible_with": ["1.0.x"]
  },
  "meta": {
    "name": "malaria_venule_space_colonization_FIXED_v2",
    "description": "FIXES: (1) Network growing outside domain bounds - constrained tissue sampling, (2) 5172 components - increased mesh synthesis radial sections and voxel repair, (3) Fragment artifacts - larger min segments and proper merge threshold",
    "seed": 42,
    "input_units": "m",
    "tags": ["malaria", "venule", "space_colonization", "fragmentation_fix_v2"]
  },
  "policies": {
    "resolution": {
      "input_units": "m",
      "min_channel_diameter": 4e-05,
      "min_voxels_across_feature": 8,
      "max_voxels": 80000000,
      "min_pitch": 2e-06,
      "max_pitch": 4e-05,
      "auto_relax_pitch": true,
      "pitch_step_factor": 1.5,
      "max_voxels_embed": 60000000,
      "max_voxels_merge": 60000000,
      "max_voxels_repair": 60000000
    },
    "domain_meshing": {
      "cache_meshes": true,
      "emit_warnings": true,
      "target_face_count": 60000,
      "voxel_pitch": null,
      "primitive_policy": {
        "sections_radial": 64,
        "sections_axial": 32,
        "sections_angular": 64,
        "subdivisions": 1
      },
      "mesh_policy": {
        "validate_watertight": true,
        "repair_if_needed": true,
        "repair_voxel_pitch": 5e-05,
        "max_faces": 400000,
        "simplify_if_over_max": true,
        "simplify_target_ratio": 0.75
      }
    },
    "ridge": {
      "enabled": true,
      "face": "top",
      "height": 0.0005,
      "thickness": 0.0005,
      "inset": 0.0,
      "overlap": 0.00025,
      "resolution": 64
    },
    "network_cleanup": {
      "enable_snap": true,
      "snap_tol": 0.00015,
      "enable_prune": true,
      "min_segment_length": 0.0002,
      "enable_merge": true,
      "merge_tol": 0.00015
    },
    "growth": {
      "enabled": true,
      "backend": "space_colonization",
      "target_terminals": 250,
      "terminal_tolerance": 0.25,
      "max_iterations": 150,
      "step_size": 0.0002,
      "min_segment_length": 0.0002,
      "max_segment_length": 0.0006,
      "min_radius": 4e-05,
      "max_radius": 0.0002,
      "backend_params": {
        "num_attraction_points": 80000,
        "influence_radius": 0.0012,
        "kill_radius": 0.00035,
        "branch_enable_after_distance": 0.0012,
        "min_branch_segment_length": 0.0002,
        "directional_bias": 0.35,
        "primary_axis": [0, 0, -1],
        "max_deviation_deg": 65.0,
        "upward_forbidden": true,
        "multi_inlet_mode": "blended",
        "collision_merge_distance": 0.0008,
        "encourage_bifurcation": true,
        "max_children_per_node": 2,
        "bifurcation_probability": 0.25,
        "min_attractions_for_bifurcation": 12,
        "bifurcation_angle_threshold_deg": 35.0,
        "progress": true,
        "kdtree_rebuild_tip_every": 1,
        "kdtree_rebuild_all_nodes_every": 15,
        "kdtree_rebuild_all_nodes_min_new_nodes": 10,
        "stall_steps_per_inlet": 20,
        "interleaving_strategy": "round_robin",
        "tissue_sampling": {
          "enabled": true,
          "strategy": "mixture",
          "n_points": 6000,
          "mixture_components": [
            {
              "weight": 0.8,
              "policy": {
                "strategy": "depth_biased",
                "depth_reference": {"mode": "face", "face": "top"},
                "depth_distribution": "power",
                "depth_min": 0.0005,
                "depth_max": 0.0016,
                "depth_power": 2.0,
                "min_distance_to_ports": 0.0006,
                "exclude_spheres": [
                  {"center": [0.0, 0.0, 0.001], "radius": 0.0003},
                  {"center": [0.003, 0.0, 0.001], "radius": 0.0003},
                  {"center": [-0.003, 0.0, 0.001], "radius": 0.0003},
                  {"center": [0.0, 0.003, 0.001], "radius": 0.0003},
                  {"center": [0.0, -0.003, 0.001], "radius": 0.0003}
                ]
              }
            },
            {
              "weight": 0.2,
              "policy": {
                "strategy": "gaussian",
                "gaussian_mean": [0.0, 0.0, 0.0002],
                "gaussian_sigma": [0.0018, 0.0018, 0.0005],
                "min_distance_to_ports": 0.0007,
                "exclude_spheres": [
                  {"center": [0.0, 0.0, 0.001], "radius": 0.0012},
                  {"center": [0.003, 0.0, 0.001], "radius": 0.0012},
                  {"center": [-0.003, 0.0, 0.001], "radius": 0.0012},
                  {"center": [0.0, 0.003, 0.001], "radius": 0.0012},
                  {"center": [0.0, -0.003, 0.001], "radius": 0.0012}
                ]
              }
            }
          ],
          "min_distance_to_ports": 0.0007
        },
        "multi_inlet_blend_sigma": 0.0025
      }
    },
    "meshing": {
      "void_mesh_policy": {
        "radial_sections": 12,
        "min_radial_sections": 8,
        "max_radial_sections": 16,
        "adaptive_resolution": true,
        "resolution_scale_with_radius": true,
        "min_radius_for_max_sections": 0.0002,
        "merge_threshold": 1e-06
      }
    },
    "mesh_synthesis": {
      "add_node_spheres": true,
      "cap_ends": false,
      "segments_per_circle": 12,
      "radius_clamp_min": 3e-05,
      "radius_clamp_max": 0.0003,
      "radius_clamp_mode": "clamp",
      "voxel_repair_synthesis": true,
      "voxel_repair_pitch": 2e-05,
      "voxel_repair_auto_adjust": true,
      "voxel_repair_max_steps": 5,
      "voxel_repair_step_factor": 1.4
    },
    "radius": {
      "mode": "murray",
      "murray_exponent": 3.0,
      "min_radius": 4e-05,
      "max_radius": 0.0002,
      "terminal_radius": 4e-05
    },
    "collision": {
      "enabled": true,
      "check_collisions": true,
      "collision_clearance": 5e-05
    },
    "composition": {
      "repair_enabled": true,
      "union_before_embed": true,
      "keep_largest_component": false,
      "merge_policy": {
        "keep_largest_component": false,
        "merge_distance": 5e-06,
        "merge_before_repair": true
      },
      "repair_policy": {
        "voxel_repair_enabled": true,
        "voxel_pitch": 3e-05,
        "auto_adjust_pitch": true,
        "max_pitch_steps": 5,
        "pitch_step_factor": 1.4,
        "fill_voxels": true,
        "remove_small_components_enabled": true,
        "min_component_faces": 100,
        "min_component_volume": 1e-13,
        "fill_holes_enabled": true,
        "smooth_enabled": false
      }
    },
    "repair": {
      "voxel_repair_enabled": true,
      "voxel_pitch": 3e-05,
      "auto_adjust_pitch": true,
      "max_pitch_steps": 5,
      "pitch_step_factor": 1.4,
      "fill_voxels": true,
      "remove_small_components_enabled": true,
      "min_component_faces": 100,
      "min_component_volume": 1e-13,
      "fill_holes_enabled": true,
      "smooth_enabled": false
    },
    "embedding": {
      "voxel_pitch": 2.5e-05,
      "shell_thickness": 0.0,
      "use_resolution_policy": true,
      "auto_adjust_pitch": true,
      "max_pitch_steps": 5,
      "pitch_step_factor": 1.4,
      "max_voxels": 60000000,
      "fallback": "auto",
      "preserve_ports_enabled": true,
      "preserve_mode": "recarve",
      "carve_radius_factor": 1.2,
      "carve_depth": 0.0006
    },
    "open_port": {
      "enabled": false
    },
    "validity": {
      "check_watertight": true,
      "check_components": true,
      "check_min_diameter": true,
      "check_open_ports": false,
      "check_bounds": true,
      "check_void_inside_domain": true,
      "min_diameter_threshold": 8e-05,
      "max_components": 50
    },
    "output": {
      "output_dir": "./out/malaria_venule_space_colonization_FIXED_v2",
      "output_units": "m",
      "save_intermediates": true,
      "save_reports": true,
      "output_stl": true,
      "output_json": true
    }
  },
  "domains": {
    "main_domain": {
      "type": "cylinder",
      "center": [0.0, 0.0, 0.0],
      "radius": 0.005,
      "height": 0.002
    }
  },
  "components": [
    {
      "id": "space_colonization_5in",
      "domain_ref": "main_domain",
      "ports": {
        "inlets": [
          {"name": "inlet_center", "position": [0.0, 0.0, 0.001], "direction": [0.0, 0.0, -1.0], "radius": 0.0002},
          {"name": "inlet_e", "position": [0.003, 0.0, 0.001], "direction": [0.0, 0.0, -1.0], "radius": 0.0002},
          {"name": "inlet_w", "position": [-0.003, 0.0, 0.001], "direction": [0.0, 0.0, -1.0], "radius": 0.0002},
          {"name": "inlet_n", "position": [0.0, 0.003, 0.001], "direction": [0.0, 0.0, -1.0], "radius": 0.0002},
          {"name": "inlet_s", "position": [0.0, -0.003, 0.001], "direction": [0.0, 0.0, -1.0], "radius": 0.0002}
        ],
        "outlets": []
      },
      "build": {
        "type": "backend_network"
      },
      "save_artifacts": {
        "network": "artifacts/space_colonization_network.json",
        "void_mesh": "artifacts/space_colonization_void.stl"
      }
    }
  ],
  "embedding": {
    "enable": true,
    "outputs": {
      "domain_with_void": "domain_with_void.stl",
      "void_mesh": "void_union.stl"
    }
  },
  "validity": {
    "enable": true,
    "save_report": "validity_report.json"
  },
  "outputs": {
    "artifacts_dir": "artifacts",
    "named": {
      "domain_mesh": "artifacts/domain_mesh_with_ridge.stl",
      "run_report": "run_report.json"
    }
  }
}
